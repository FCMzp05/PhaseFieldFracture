QWidget {
    background: #edf2f7;
    color: #1d2733;
    font-size: 11pt;
}

QFrame#topBar,
QFrame#bottomCard,
QFrame[card="true"] {
    background: #f7f9fc;
    border: 1px solid #dbe3ec;
    border-radius: 18px;
}

QFrame[section="true"] {
    background: #ffffff;
    border: 1px solid #e5ebf2;
    border-radius: 14px;
}

QScrollArea#leftScrollArea {
    border: none;
    background: transparent;
}

QScrollArea#leftScrollArea > QWidget > QWidget {
    background: transparent;
}

QLabel#eyebrowLabel {
    color: #5f7891;
    font-size: 10pt;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

QLabel#windowTitleLabel {
    color: #1f2b37;
    font-size: 21pt;
    font-weight: 700;
}

QLabel#headerStatusLabel {
    color: #334155;
    font-size: 11.5pt;
    font-weight: 600;
}

QLabel#headerMetaLabel,
QLabel#cardSubtitleLabel,
QLabel#cardMetaLabel,
QLabel#hintLabel,
QLabel#vtkLabel,
QLabel#bottomStatusLabel {
    color: #617184;
    line-height: 1.35em;
}

QLabel#cardTitleLabel {
    color: #1f2b37;
    font-size: 14pt;
    font-weight: 700;
}

QLabel#sectionTitleLabel,
QLabel#miniCaptionLabel {
    color: #4c6378;
    font-size: 10pt;
    font-weight: 700;
    letter-spacing: 0.03em;
}

QLabel#stageBadge {
    background: #d9e7f3;
    color: #284b6b;
    border: 1px solid #c6d8e8;
    border-radius: 999px;
    font-size: 10pt;
    font-weight: 700;
    padding: 4px 12px;
}

QLabel#primaryImageLabel {
    background: #eef3f8;
    border: 1px solid #d7e0ea;
    border-radius: 18px;
    color: #6a7b8c;
    padding: 28px;
}

QLineEdit,
QComboBox,
QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #d7e0ea;
    border-radius: 12px;
    padding: 9px 12px;
    selection-background-color: #b8cde2;
}

QLineEdit:focus,
QComboBox:focus,
QPlainTextEdit:focus {
    border: 1px solid #8ba8c2;
}

QLineEdit:disabled,
QComboBox:disabled {
    background: #f1f4f7;
    color: #98a5b3;
    border-color: #e3e8ef;
}

QComboBox {
    min-height: 20px;
    padding-right: 28px;
}

QComboBox::drop-down {
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d7e0ea;
    selection-background-color: #d8e4ef;
    selection-color: #1f2b37;
}

QPushButton {
    min-height: 20px;
    padding: 10px 16px;
    border-radius: 12px;
    border: 1px solid #ccd8e4;
    background: #ffffff;
    color: #294055;
    font-weight: 600;
}

QPushButton:hover {
    background: #f3f7fb;
    border-color: #b7c8d8;
}

QPushButton:pressed {
    background: #e9f0f7;
}

QPushButton:disabled {
    background: #f1f4f7;
    color: #98a5b3;
    border-color: #e1e7ee;
}

QPushButton[role="primary"] {
    background: #335f8a;
    border: 1px solid #335f8a;
    color: #ffffff;
}

QPushButton[role="primary"]:hover {
    background: #2d547b;
    border-color: #2d547b;
}

QPushButton[role="primary"]:pressed {
    background: #274969;
    border-color: #274969;
}

QPushButton[role="secondary"] {
    background: #f7f9fc;
    border: 1px solid #ccd8e4;
    color: #294055;
}

QPushButton[role="danger"] {
    background: #f8eded;
    border: 1px solid #dfc3c3;
    color: #8b3c3c;
}

QPushButton[role="danger"]:hover {
    background: #f3e1e1;
    border-color: #d6afaf;
}

QProgressBar {
    background: #e6edf4;
    border: none;
    border-radius: 8px;
    min-height: 12px;
    text-align: center;
    color: #536476;
}

QProgressBar::chunk {
    background: #4f7aa4;
    border-radius: 8px;
}

QPlainTextEdit {
    background: #f8fafc;
    color: #233242;
    border-radius: 14px;
}

QLabel {
    background: transparent;
}
